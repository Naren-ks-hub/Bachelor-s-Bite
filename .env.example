# ====================================================================
# 🌐 TiDB Cloud Database Configuration Template
# Obtain credentials from TiDB Cloud Console (https://tidbcloud.com)
# Cluster > Connect > Connect with MySQL / Node.js
# ====================================================================
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_username
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=bachelor_bite
TIDB_ENABLE_SSL=true

# Alternative single connection string format:
# DATABASE_URL=mysql://<username>:<password>@<host>:4000/bachelor_bite?ssl={"rejectUnauthorized":true}

PORT=3000
